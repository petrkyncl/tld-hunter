# All data sources work without credentials. These only tune or extend them.

# Parallelism of the two scan phases. The DNS sweep is cheap and can go wide;
# the registry pass is bounded per host anyway, so raising it mostly helps when
# many different registries are involved. Sensible on a VPS: 160 / 64.
SCAN_DNS_CONCURRENCY=96
SCAN_AUTH_CONCURRENCY=48

# Optional: unlocks exact prices including premium tiers in the domain detail
# panel (Porkbun's checkDomain endpoint). Without them the app falls back to the
# public standard price list.
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# Required for the AI agent tab. Without it the sweep still works; the agent
# reports a missing key instead of running. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: when set, the agent endpoint only answers requests carrying this code
# in the x-agent-code header. Leave it empty for local development; set it on any
# public deployment, because every agent run spends real money.
AGENT_ACCESS_CODE=

# Optional: where finished agent runs are stored. Defaults to .data/runs.
AGENT_DATA_DIR=

# Optional: serve the app from a sub-path, e.g. /tld behind a shared nginx host.
NEXT_PUBLIC_BASE_PATH=
